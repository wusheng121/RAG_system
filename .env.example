# 环境变量示例文件
# 复制此文件为 .env 并按需填写实际值（不填的项会使用代码中的默认值）

# ===== LLM =====
# 阿里云 DashScope API Key（不填则 LLM 被禁用，客服退化为检索/直答）
ALI_API_KEY=your-ali-api-key
# 兼容 OpenAI 接口的基址与模型名
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ===== 鉴权 =====
# JWT 签名密钥，生产必须设置为长随机串；ENV=production 时用默认值会启动失败
SECRET_KEY=replace-with-a-long-random-secret
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== 运行环境 =====
# development（默认，宽松）/ production（强制安全配置）
# ENV=development

# ===== 数据库 =====
# DATABASE_URL=sqlite:///./bookstore.db

# ===== CORS =====
# 允许跨域带凭证的来源，逗号分隔
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ===== 检索 / 模型 =====
# 仅用本地 HF 缓存，避免联网校验导致 SSL 问题；首次需 python download_models.py
# HF_LOCAL_FILES_ONLY=1
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# 检索索引缓存目录
# CACHE_DIR=data/cache

# ===== 日志 =====
# LOG_LEVEL=INFO
